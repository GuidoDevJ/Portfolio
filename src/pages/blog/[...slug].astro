---
import { getCollection } from "astro:content";
import BlogLayout from "src/layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const all = await getCollection("blog", ({ data }) => !data.draft);
  // Translations are rendered inside their original's page, so they get no route of their own.
  const originals = all.filter((post) => !post.data.translationOf);

  return originals.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      translation: all.find((p) => p.data.translationOf === post.slug),
    },
  }));
}

const { post, translation } = Astro.props;
const { Content } = await post.render();
const TranslatedContent = translation ? (await translation.render()).Content : undefined;
const { title, description, pubDate, updatedDate, tags } = post.data;

const formatDate = (date: Date, locale: string) =>
  date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric" });
---

<BlogLayout title={`${title} | Guido Gauna`} description={description} type="article">
  <div class="bilingual">
    <a class="blog-back" href="/blog" data-lang="en">&larr; Back to blog</a>
    <a class="blog-back" href="/blog" data-lang="es">&larr; Volver al blog</a>
  </div>
  <div class:list={{ bilingual: !!translation }}>
    <article>
      <header>
        <h1 data-lang="en">{title}</h1>
        {translation && <h1 data-lang="es">{translation.data.title}</h1>}
        <p class="meta">
          <time datetime={pubDate.toISOString()}>
            <span data-lang="en">{formatDate(pubDate, "en-US")}</span>
            <span data-lang="es">{formatDate(pubDate, "es-AR")}</span>
          </time>
          {
            updatedDate && (
              <span>
                &middot;
                <span data-lang="en">Updated {formatDate(updatedDate, "en-US")}</span>
                <span data-lang="es">Actualizado {formatDate(updatedDate, "es-AR")}</span>
              </span>
            )
          }
          {tags.length > 0 && <span> &middot; {tags.join(", ")}</span>}
        </p>
      </header>
      <div class="prose" data-lang="en">
        <Content />
      </div>
      {
        TranslatedContent && (
          <div class="prose" data-lang="es">
            <TranslatedContent />
          </div>
        )
      }
    </article>
  </div>
</BlogLayout>

<style>
  h1 {
    font-size: var(--font-size-4xl);
    line-height: 1.15;
    color: var(--color-text-heading);
    margin: 0 0 var(--spacing-sm);
  }
  .meta { color: var(--color-text-secondary); margin: 0 0 var(--spacing-xl); }
  .prose { font-size: var(--font-size-md); line-height: 1.75; }
  .prose :global(h2), .prose :global(h3) {
    color: var(--color-text-heading);
    line-height: 1.3;
    margin: var(--spacing-2xl) 0 var(--spacing-md);
  }
  .prose :global(h2) { font-size: var(--font-size-2xl); }
  .prose :global(h3) { font-size: var(--font-size-xl); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 var(--spacing-lg); }
  .prose :global(ul), .prose :global(ol) { padding-left: var(--spacing-xl); }
  .prose :global(blockquote) {
    margin: var(--spacing-lg) 0;
    padding: var(--spacing-sm) var(--spacing-lg);
    border-left: 4px solid var(--color-primary);
    background: var(--color-background-secondary);
    color: var(--color-text-secondary);
  }
  .prose :global(code) {
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: var(--radius-md);
    background: var(--color-background-secondary);
  }
  .prose :global(pre) {
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 0 0 var(--spacing-lg);
  }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 var(--spacing-lg); }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: var(--spacing-sm) var(--spacing-md);
    text-align: left;
  }
</style>
