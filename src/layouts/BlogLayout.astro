---
import SEO from "src/components/SEO/SEO.astro";
import "../public/css/index.css";
import "../public/css/hover.css";
import "../public/css/animations.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const { title, description, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} type={type} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;500;700&family=Source+Sans+Pro:wght@300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <script is:inline>
      const theme = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);

      const lang = localStorage.getItem('language') ||
        (navigator.language.startsWith('es') ? 'es' : 'en');
      document.documentElement.setAttribute('lang', lang);
    </script>
  </head>

  <body>
    <button
      id="blog-lang-toggle"
      class="blog-lang-toggle"
      type="button"
      aria-label="Switch language / Cambiar idioma"
      title="Switch language / Cambiar idioma"
    >
      <span id="blog-lang-flag" aria-hidden="true"></span>
      <span id="blog-lang-code"></span>
    </button>
    <main class="blog-main">
      <slot />
    </main>

    <script is:inline>
      (function () {
        var btn = document.getElementById('blog-lang-toggle');
        var flag = document.getElementById('blog-lang-flag');
        var code = document.getElementById('blog-lang-code');
        var root = document.documentElement;
        var isEs = function () { return (root.getAttribute('lang') || '').indexOf('es') === 0; };
        var render = function () {
          flag.textContent = isEs() ? '🇪🇸' : '🇺🇸';
          code.textContent = isEs() ? 'ES' : 'EN';
        };
        btn.addEventListener('click', function () {
          var next = isEs() ? 'en' : 'es';
          root.setAttribute('lang', next);
          try { localStorage.setItem('language', next); } catch (e) {}
          render();
        });
        render();
      })();
    </script>
  </body>
</html>

<style is:global>
  .blog-main {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
    font-family: var(--font-family-primary);
    color: var(--color-text-primary);
  }
  .blog-main a {
    color: var(--color-text-heading);
    text-decoration-color: var(--color-primary);
  }
  /* Bilingual content: English is the default; Spanish shows only when the page has a translation. */
  [data-lang="es"] { display: none; }
  html[lang^="es"] .bilingual [data-lang="es"] { display: revert; }
  html[lang^="es"] .bilingual [data-lang="en"] { display: none; }

  .blog-lang-toggle {
    position: fixed;
    top: var(--spacing-md);
    right: var(--spacing-md);
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-background-secondary);
    color: var(--color-text-primary);
    font-family: var(--font-family-primary);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .blog-back {
    display: inline-block;
    margin-bottom: var(--spacing-xl);
    font-weight: var(--font-weight-semibold);
  }
</style>
